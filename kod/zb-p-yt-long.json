    "Yakuniy matn": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var ds=$(\"Bloklarni yig'ish\").first().json;\nvar tts=$json.tts_final||\"\";\nvar words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar wc=words.length;var xatolar=[];\nvar minSoz=$json.minSoz||ds.minSoz||700;var maxSoz=$json.maxSoz||ds.maxSoz||1100;\nif(wc<minSoz||wc>maxSoz)xatolar.push(\"So'z soni \"+wc+\", \"+minSoz+\"-\"+maxSoz+\" kerak\");\nvar faktlar=$json.faktlar||ds.faktlar||[];\nvar fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}\nvar pm=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var k=0;k<fr.length;k++){if(fr[k].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,tts_matn:tts,sarlavha:$json.sarlavha||ds.sarlavha||\"\",rejim_info:$json.rejim_info||\"\",faktlar:faktlar,mavzu_kod:$json.mavzu_kod||ds.mavzu_kod,job_id:$json.job_id||ds.job_id,avatar_kod:$json.avatar_kod||ds.avatar_kod,test_rejim:$json.test_rejim||ds.test_rejim,voice_id:$json.voice_id||ds.voice_id,talking_photo_id:$json.talking_photo_id||ds.talking_photo_id,urinish:$json.urinish||1}};"
    },
