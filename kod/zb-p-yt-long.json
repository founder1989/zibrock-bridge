    "Bloklarni yig'ish": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;\nvar pas={};try{pas=$(\"Pasport o'qish\").first().json||{};}catch(e){}\nvar minS=parseFloat(pas.uzunlik_min_s||300);var maxS=parseFloat(pas.uzunlik_max_s||480);\nvar minSoz=Math.round(minS*2.2);var maxSoz=Math.round(maxS*2.6);\n\nvar bloklar=[];\ntry{bloklar=$(\"Epizod bloklarni o'qish\").all().map(function(i){return i.json;});}catch(e){}\nbloklar.sort(function(a,b){return(parseInt(a.tartib||0))-(parseInt(b.tartib||0));});\n\nif(bloklar.length===0){\n  return[{json:{eskalatsiya:true,xabar:\"epizod_bloklar'da T\"+inp.mavzu_kod+\" uchun blok yo'q\",job_id:inp.job_id}}];\n}\n\n// Rejim\nvar rejim=bloklar[0].rejim||\"QULF\";\nvar sarlavha=bloklar[0].sarlavha||inp.burchak;\nvar tts_bloklar=bloklar.map(function(b){return b.matn||\"\";}).filter(Boolean);\nvar tts_raw=tts_bloklar.join(\"\\n\\n\");\n\nvar ctaL=\"\";try{var ctaRL=$(\"CTA o'qish\").first().json||{};ctaL=ctaRL.matn||\"\";}catch(e){}\nif([\"T1\",\"T2\",\"T3\"].indexOf(inp.mavzu_kod)>=0)ctaL=\"\";\nreturn[{json:{\n  job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,\n  faktlar:inp.faktlar,burchak:inp.burchak,urinish:inp.urinish||1,\n  voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,\n  minSoz:minSoz,maxSoz:maxSoz,rejim:rejim,sarlavha:sarlavha,\n  tts_raw:tts_raw,bloklar:bloklar,qaytaOgoh:false,ctaMatn:ctaL\n}}];"
    },
