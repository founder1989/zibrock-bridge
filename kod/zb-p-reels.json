    "Skript parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);\nvar p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}\nvar ds=$(\"Ma'lumot manbalarini birlashtirish\").first().json;\nvar fullTts=ds.hookMatn+\" \"+(p.tts_tana||\"\");\nvar cta=ds.noVerbalCta?\"\":( p.ulashish_cta||\"\");\nreturn{json:{hook:ds.hookMatn,tts_matn:fullTts,sceneBlocks:p.sceneBlocks||[],manba:p.manba||\"\",caption:p.caption||\"\",heshteglar:[\"#psikoloji\",\"#disiplin\",\"#istatistik\",\"#bilim\",\"#davranisalfinans\"],ulashish_cta:cta,faktlar:ds.faktlar,mavzu_kod:ds.mavzu_kod,variant_idx:ds.variant_idx,job_id:ds.job_id,avatar_kod:ds.avatar_kod,test_rejim:ds.test_rejim,voice_id:ds.voice_id,talking_photo_id:ds.talking_photo_id,urinish:ds.urinish||1,minSoz:ds.minSoz,maxSoz:ds.maxSoz,ilgak_s:ds.ilgak_s,qaytaOgoh:ds.qaytaOgoh}};"
    },
    "Skript tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var tts=$json.tts_matn||\"\";var words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar wc=words.length;var faktlar=$json.faktlar||[];var xatolar=[];\nvar minSoz=$json.minSoz||38;var maxSoz=$json.maxSoz||50;\nif(wc<minSoz||wc>maxSoz)xatolar.push(\"So'z soni \"+wc+\", \"+minSoz+\"-\"+maxSoz+\" kerak\");\nvar cap=$json.caption||\"\";if([...(cap)].length>125)xatolar.push(\"Caption \"+[...cap].length+\" belgi, max 125\");\nvar fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}\nvar pm=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var k=0;k<fr.length;k++){if(fr[k].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}\nvar ogohlantirish=$json.qaytaOgoh?\"QAYTA TEKSHIR: daraja C\":\"\";\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,ogohlantirish:ogohlantirish,tts_matn:tts,hook:$json.hook,sceneBlocks:$json.sceneBlocks,heshteglar:$json.heshteglar,manba:$json.manba,caption:cap,ulashish_cta:$json.ulashish_cta,faktlar:faktlar,mavzu_kod:$json.mavzu_kod,variant_idx:$json.variant_idx,job_id:$json.job_id,avatar_kod:$json.avatar_kod,test_rejim:$json.test_rejim,voice_id:$json.voice_id,talking_photo_id:$json.talking_photo_id,urinish:$json.urinish||1,ilgak_s:$json.ilgak_s}};"
    },
