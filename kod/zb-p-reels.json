    "Ma'lumot manbalarini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;\nvar pas={};try{pas=$(\"Pasport o'qish\").first().json||{};}catch(e){}\nvar minS=parseFloat(pas.uzunlik_min_s||15);var maxS=parseFloat(pas.uzunlik_max_s||20);\nvar minSoz=Math.round(minS*2.2);var maxSoz=Math.round(maxS*2.6);\nvar ilgak_s=parseFloat(pas.ilgak_s||1.7);\nvar hookMatn=\"\";\ntry{var hRow=$(\"Hook o'qish\").first().json||{};hookMatn=hRow.instagram||hRow.matn||\"\";}catch(e){}\nif(!hookMatn){hookMatn=inp.faktlar&&inp.faktlar[0]?inp.faktlar[0].matn.slice(0,60):\"\";}\nvar ctaMatn=\"\";try{var ctaRow=$(\"CTA o'qish\").first().json||{};ctaMatn=ctaRow.matn||\"\";}catch(e){}\nvar noVerbalCta=[\"T1\",\"T2\",\"T3\"].indexOf(inp.mavzu_kod)>=0;if(noVerbalCta)ctaMatn=\"\";\nvar faktlar=inp.faktlar||[];var filteredFaktlar=[];var qaytaOgoh=false;\nfor(var i=0;i<faktlar.length;i++){if(String(faktlar[i].meta_tiktok||\"\").toLowerCase()===\"taqiq\")continue;if(faktlar[i].daraja===\"C\")qaytaOgoh=true;filteredFaktlar.push(faktlar[i]);}\nreturn[{json:{job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,faktlar:filteredFaktlar,variant_idx:inp.variant_idx,urinish:inp.urinish||1,voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,minSoz:minSoz,maxSoz:maxSoz,ilgak_s:ilgak_s,hookMatn:hookMatn,noVerbalCta:noVerbalCta,qaytaOgoh:qaytaOgoh,ctaMatn:ctaMatn}}];"
    },
    "Claude - Reels Tana": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 600,
