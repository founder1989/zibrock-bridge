    "Kirish va baza birlashtirish": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;var bazaMatn=\"\";try{var row=$(\"TG Post baza o'qish\").first().json||{};bazaMatn=row.matn||row.html||\"\";}catch(e){}var ctaTG=\"\";try{var ctaRTG=$(\"CTA o'qish\").first().json||{};ctaTG=ctaRTG.matn||\"\";}catch(e){} if([\"T1\",\"T2\",\"T3\"].indexOf(inp.mavzu_kod)>=0)ctaTG=\"\"; return[{json:{job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,burchak:inp.burchak,faktlar:inp.faktlar||[],urinish:inp.urinish||1,bazaMatn:bazaMatn,bazaBor:bazaMatn.length>0,ctaMatn:ctaTG}}];"
