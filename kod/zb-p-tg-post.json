    "Kirish tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var p=$json.paket||$json;var burchak=(p.burchaklar&&p.burchaklar.tg_post&&p.burchaklar.tg_post[0])||\"Haftanin rakami\";return{json:{job_id:p.job_id||\"UNKNOWN\",mavzu_kod:p.mavzu_kod||\"T1\",burchak:burchak,faktlar:p.faktlar||[],urinish:1}};"
    },
    "Mavzu Himoyasi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var inp=$json;var mc=inp.mavzu_kod||\"\";if(mc===\"T8\")return {json:{...inp,__stop:true,__mesaj:\"T8 — AI avatar taqiq, real odam kerak\"}};if(mc===\"T10\"&&false)return {json:{...inp,__stop:true,__mesaj:\"T10 — Meta/TikTok'da taqiq\"}};return {json:{...inp,__stop:false}};"
