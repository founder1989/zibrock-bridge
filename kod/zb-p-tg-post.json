    "Post parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);var parsed;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");parsed=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\",xabar:String(err),urinish:$(\"Kirish va baza birlashtirish\").first().json.urinish||1}};}var inp=$(\"Kirish va baza birlashtirish\").first().json;return{json:{post_html:parsed.post_html||\"\",belgi_soni:parseInt(parsed.belgi_soni||0),faktlar:inp.faktlar,burchak:inp.burchak,job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,urinish:inp.urinish||1}};"
    },
    "Post tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var postHtml=$json.post_html||\"\";var faktlar=$json.faktlar||[];var xatolar=[];var bare=postHtml.replace(new RegExp(\"<[^>]+>\",\"g\"),\"\").replace(new RegExp(\"&[a-z]+;\",\"g\"),\"X\");var uzunlik=bare.length;if(uzunlik<500)xatolar.push(\"Uzunlik \"+uzunlik+\" belgi, min 500\");if(uzunlik>900)xatolar.push(\"Uzunlik \"+uzunlik+\" belgi, max 900\");// First line bold check\nvar firstLine=(postHtml.split(\"\\n\")[0]||\"\");if(!firstLine.indexOf(\"<b>\")>=0||[...firstLine.replace(new RegExp(\"<[^>]+>\",\"g\"),\"\")].length>80)xatolar.push(\"1-qator qalin emas yoki 80 belgidan uzun\");var badTags=postHtml.match(new RegExp(\"<(?!\\\\/?( b|i))[^>]+>\",\"gi\"))||[];if(badTags.length>0)xatolar.push(\"Noto'g'ri teglar: \"+badTags.join(\", \"));if(postHtml.indexOf(\"Kaynak:\")<0&&postHtml.indexOf(\"kaynak:\")<0)xatolar.push(\"Kaynak: yo'q\");var fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}var pm=bare.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];for(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var fk=0;fk<fr.length;fk++){if(fr[fk].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}return{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,post_html:postHtml,belgi_soni:uzunlik,job_id:$json.job_id,burchak:$json.burchak,mavzu_kod:$json.mavzu_kod,faktlar:faktlar,urinish:$json.urinish||1}};"
    },
