    "K1 natijasini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var k1=$json;var sc=$(\"Post tekshiruvi\").item.json;var k1H=k1.holat||\"FAIL\";var xa=sc.xatolar||[];if(k1H===\"FAIL\"){xa=xa.concat((k1.topilmalar||[]).map(function(t){return\"K1 \"+t.tur+\": \"+t.atama;}));}return{json:{holat:(sc.holat===\"PASS\"&&k1H===\"PASS\")?\"PASS\":\"FAIL\",xatolar:xa,post_html:sc.post_html,belgi_soni:sc.belgi_soni,job_id:sc.job_id,burchak:sc.burchak,mavzu_kod:sc.mavzu_kod,faktlar:sc.faktlar,urinish:sc.urinish||1}};"
