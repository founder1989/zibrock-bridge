    "Ma'lumot manbalarini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;\n// Pasport\nvar pas={};\ntry{pas=$(\"Pasport o'qish\").first().json||{};}catch(e){}\nvar minS=parseFloat(pas.uzunlik_min_s||15);var maxS=parseFloat(pas.uzunlik_max_s||30);\nvar minSoz=Math.round(minS*2.2);var maxSoz=Math.round(maxS*2.6);\nvar ilgak_s=parseFloat(pas.ilgak_s||1.5);\n\n// Hook jadvaldan\nvar hookMatn=\"\";\ntry{var hRow=$(\"Hook o'qish\").first().json||{};hookMatn=hRow.tiktok||hRow.matn||\"\";}catch(e){}\nif(!hookMatn){hookMatn=inp.faktlar&&inp.faktlar[0]?inp.faktlar[0].matn.slice(0,60):\"Dikkat!\";}\n\n// CTA jadvaldan\nvar ctaKod=\"TR-C-0\";var ctaMatn=\"\";\ntry{var ctaRow=$(\"CTA o'qish\").first().json||{};ctaKod=ctaRow.kod||\"TR-C-0\";ctaMatn=ctaRow.matn||\"\";}catch(e){}\nvar noVerbalCta=[\"T1\",\"T2\",\"T3\"].indexOf(inp.mavzu_kod)>=0;\nif(noVerbalCta){ctaKod=\"TR-C-0\";ctaMatn=\"\";}\n\n// meta_tiktok tekshiruvi\nvar faktlar=inp.faktlar||[];\nvar filteredFaktlar=[];var qaytaOgoh=false;\nfor(var i=0;i<faktlar.length;i++){\n  var f=faktlar[i];\n  var mt=String(f.meta_tiktok||\"\").toLowerCase();\n  if(mt===\"taqiq\")continue; // metasafe'da ishlatilmaydi\n  if(f.daraja===\"C\")qaytaOgoh=true;\n  filteredFaktlar.push(f);\n}\n\nreturn[{json:{\n  job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,\n  faktlar:filteredFaktlar,variant_idx:inp.variant_idx,urinish:inp.urinish||1,\n  voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,\n  minSoz:minSoz,maxSoz:maxSoz,ilgak_s:ilgak_s,\n  hookMatn:hookMatn,ctaKod:ctaKod,ctaMatn:ctaMatn,\n  qaytaOgoh:qaytaOgoh\n}}];"
    },
    "Claude - TikTok Tana": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 600,
      "system": "",
      "creds": {
        "anthropicApi": "Anthropic account 2"
      }
    },
    "Skript parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);\nvar p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}\nvar ds=$(\"Ma'lumot manbalarini birlashtirish\").first().json;\nvar fullTts=ds.hookMatn+\" \"+( p.tts_tana||\"\");\nreturn{json:{hook:ds.hookMatn,tts_matn:fullTts,tts_tana:p.tts_tana||\"\",sceneBlocks:p.sceneBlocks||[],manba:p.manba||\"\",tavsif:p.tavsif||\"\",heshteglar:[\"#psikoloji\",\"#disiplin\",\"#istatistik\",\"#bilim\",\"#davranisalfinans\"],faktlar:ds.faktlar,mavzu_kod:ds.mavzu_kod,variant_idx:ds.variant_idx,job_id:ds.job_id,avatar_kod:ds.avatar_kod,test_rejim:ds.test_rejim,voice_id:ds.voice_id,talking_photo_id:ds.talking_photo_id,urinish:ds.urinish||1,minSoz:ds.minSoz,maxSoz:ds.maxSoz,ilgak_s:ds.ilgak_s,ctaKod:ds.ctaKod,qaytaOgoh:ds.qaytaOgoh}};"
    },
    "Skript tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var tts=$json.tts_matn||\"\";var words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar wc=words.length;var faktlar=$json.faktlar||[];var xatolar=[];\n// Q2: Pasportdan olingan chegaralar\nvar minSoz=$json.minSoz||38;var maxSoz=$json.maxSoz||75;\nif(wc<minSoz||wc>maxSoz)xatolar.push(\"So'z soni \"+wc+\", \"+minSoz+\"-\"+maxSoz+\" bolishi kerak\");\nif($json.heshteglar.length!==5)xatolar.push(\"Heshteg soni noto'g'ri (5 ta kerak)\");\n// Kapta ≤100\nvar tavsif=$json.tavsif||\"\";\nif(tavsif.length>100)xatolar.push(\"Caption \"+tavsif.length+\" belgi, max 100\");\nif(tavsif.indexOf(\"http\")>=0||tavsif.indexOf(\"t.me\")>=0)xatolar.push(\"Captionda havola bor\");\n// Raqamlar N-ID tekshiruvi\nvar faktIds={};for(var fi=0;fi<faktlar.length;fi++){var qv=String(faktlar[fi].qiymat||faktlar[fi].matn||\"\");var nm=qv.match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<nm.length;j++)faktIds[nm[j]]=faktlar[fi].s_id||\"?\";}\nvar pm=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var found=false;for(var k in faktIds){if(k.indexOf(n)>=0){found=true;break;}}if(!found)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}\nvar ogohlantirish=$json.qaytaOgoh?\"QAYTA TEKSHIR: daraja C fakt bor\":\"\";\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,ogohlantirish:ogohlantirish,tts_matn:tts,hook:$json.hook,sceneBlocks:$json.sceneBlocks,heshteglar:$json.heshteglar,manba:$json.manba,tavsif:tavsif,faktlar:faktlar,mavzu_kod:$json.mavzu_kod,variant_idx:$json.variant_idx,job_id:$json.job_id,avatar_kod:$json.avatar_kod,test_rejim:$json.test_rejim,voice_id:$json.voice_id,talking_photo_id:$json.talking_photo_id,urinish:$json.urinish||1,ilgak_s:$json.ilgak_s}};"
    },
