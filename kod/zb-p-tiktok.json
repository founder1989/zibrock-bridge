    "K1 natijasini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var k1=$json;\nvar script=$(\"Skript tekshiruvi\").item.json;\nvar k1Holat=k1.holat||\"FAIL\";\nvar xatolar=script.xatolar||[];\nif(k1Holat===\"FAIL\"){xatolar=xatolar.concat((k1.topilmalar||[]).map(function(t){return\"K1 \"+t.tur+\": \"+t.atama;}));}\nreturn{json:{holat:(script.holat===\"PASS\"&&k1Holat===\"PASS\")?\"PASS\":\"FAIL\",xatolar:xatolar,tts_matn:script.tts_matn,hook:script.hook,sceneBlocks:script.sceneBlocks,heshteglar:script.heshteglar,manba:script.manba,tavsif:script.tavsif,faktlar:script.faktlar,burchak:script.burchak,variant_idx:script.variant_idx,job_id:script.job_id,avatar_kod:script.avatar_kod,test_rejim:script.test_rejim,voice_id:script.voice_id,talking_photo_id:script.talking_photo_id,urinish:script.urinish||1}};"
