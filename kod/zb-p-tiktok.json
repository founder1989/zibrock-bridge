    },
    "Mavzu Himoyasi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var inp=$json;var mc=inp.mavzu_kod||\"\";if(mc===\"T8\")return {json:{...inp,__stop:true,__mesaj:\"T8 — AI avatar taqiq, real odam kerak\"}};if(mc===\"T10\"&&true)return {json:{...inp,__stop:true,__mesaj:\"T10 — Meta/TikTok'da taqiq\"}};return {json:{...inp,__stop:false}};"
