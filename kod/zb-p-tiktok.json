    "Kirish tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var p=$json.paket||$json;var vi=parseInt($json.variant_idx||0);\nvar burchaklar=p.burchaklar&&p.burchaklar.tiktok||[];\nvar burchak=burchaklar[vi]||burchaklar[0]||\"Trader kayıp istatistikleri\";\nreturn{json:{job_id:p.job_id||\"UNKNOWN\",mavzu_kod:p.mavzu_kod||\"T1\",avatar_kod:p.avatar_kod||\"a1\",test_rejim:p.test_rejim||false,faktlar:p.faktlar||[],burchak:burchak,variant_idx:vi,urinish:1,voice_id:p.voice_id||\"7VqWGAWwo2HMrylfKrcm\",talking_photo_id:p.talking_photo_id||\"08617ecb814d40be876db3b1c7b83da0\"}};"
    },
    "Claude - TikTok Skript": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 800,
      "system": "",
      "creds": {
        "anthropicApi": "Anthropic account 2"
      }
    },
    "Skript parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);\nvar parsed;\ntry{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");parsed=JSON.parse(raw.slice(s,e+1));}\ncatch(err){return{json:{xato:true,tur:\"PARSE_FAIL\",xabar:String(err)}};}\nvar inp=$(\"Kirish tayyorlash\").item.json;\nreturn{json:{hook:parsed.hook||\"\",tts_matn:parsed.tts_matn||\"\",sceneBlocks:parsed.sceneBlocks||[],manba:parsed.manba||\"\",tavsif:parsed.tavsif||\"\",heshteglar:parsed.heshteglar||[],faktlar:inp.faktlar,burchak:inp.burchak,variant_idx:inp.variant_idx,job_id:inp.job_id,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,urinish:inp.urinish||1}};"
    },
    "Skript tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var tts=$json.tts_matn||\"\";var words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar wordCount=words.length;var hook=$json.hook||\"\";var hookWords=hook.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar heshteglar=$json.heshteglar||[];var faktlar=$json.faktlar||[];\nvar xatolar=[];\nif(wordCount<38||wordCount>75)xatolar.push(\"So z soni \"+wordCount+\", 38-75 bolishi kerak\");\nif(hookWords.length>4)xatolar.push(\"Ilgak \"+hookWords.length+\" so z, max 4\");\nif(heshteglar.length!==4)xatolar.push(\"Heshteg soni \"+heshteglar.length+\", 4 bolishi kerak\");\n// Check numbers in faktlar\nvar faktRaqamlar=[];\nfor(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)faktRaqamlar.push(m[j]);}\nvar pctM=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pctM.length;pi++){var num=pctM[pi].replace(\"%\",\"\");var found=false;for(var fk=0;fk<faktRaqamlar.length;fk++){if(faktRaqamlar[fk].indexOf(num)>=0){found=true;break;}}if(!found)xatolar.push(\"Ixtiro raqam: \"+pctM[pi]+\" faktlarda yoq\");}\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,tts_matn:tts,hook:$json.hook,sceneBlocks:$json.sceneBlocks,heshteglar:heshteglar,manba:$json.manba,tavsif:$json.tavsif,faktlar:faktlar,burchak:$json.burchak,variant_idx:$json.variant_idx,job_id:$json.job_id,avatar_kod:$json.avatar_kod,test_rejim:$json.test_rejim,voice_id:$json.voice_id,talking_photo_id:$json.talking_photo_id,urinish:$json.urinish||1}};"
    },
