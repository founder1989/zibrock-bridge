    "Manbalar qurish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var faktlar=$json.faktlar||[];var slaydlar=[];var batchSize=3;for(var i=0;i<faktlar.length&&slaydlar.length<4;i+=batchSize){var batch=faktlar.slice(i,i+batchSize);var bodyText=batch.map(function(f,j){return(i+j+1)+\". \"+(f.manba_toliq||f.manba||\"?\")+\" — \"+(f.matn||\"\").slice(0,80);}).join(\" | \");slaydlar.push({n:slaydlar.length+1,layout:slaydlar.length===0?\"cover\":\"content\",title:slaydlar.length===0?\"Bu analizin kaynakları\":\"Kaynaklar \"+(i/batchSize+1),body:bodyText});}if(slaydlar.length===0)slaydlar=[{n:1,layout:\"cover\",title:\"Kaynaklar\",subtitle:\"Tüm kaynaklar\"}];var brand={brand_name:\"ZIBROCK\",handle:\"@zibrock_turkiye\",logo_url:\"\",color_ground:\"#0A1727\",color_tile:\"#D6AD62\",color_porcelain:\"#F7F5F0\",color_gold:\"#D6AD62\",color_ink:\"#0A1727\",color_muted_dark:\"#9CA3AF\",color_muted_light:\"#6B7280\",font_display:\"Sora\",font_body:\"Inter\",font_css_url:\"https://fonts.googleapis.com/css2?family=Sora:wght@700&family=Inter:wght@600&display=block\",output_format:\"png\",motif_key:\"instrument\"};var carousel={language:\"tr\",slides:slaydlar,caption:\"<b>Bu analizin kaynakları</b>\",hashtags:[]};return{json:{brand:brand,carousel:carousel,carouselId:\"manbalar-\"+($json.job_id||\"t1\"),caption_html:carousel.caption,mavzu_kod:$json.mavzu_kod}};"
