    "Setup birlashtirish": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var rows=$input.all().map(function(i){return i.json;});var existing=\"\";for(var i=0;i<rows.length;i++){if(rows[i].kalit===\"telegraph_token\"&&rows[i].qiymat&&rows[i].qiymat.length>10){existing=rows[i].qiymat;break;}}var ki=$(\"Kirish tayyorlash\").first().json;var tok=existing;if(!tok){var resp=await $helpers.httpRequest({method:\"POST\",url:\"https://api.telegra.ph/createAccount\",json:true,body:{short_name:\"ZIBROCK\",author_name:\"ZIBROCK ekibi\"}});tok=(resp.result&&resp.result.access_token)||\"\";}return[{json:{telegraph_token:tok,mavzu_kod:ki.mavzu_kod,test_rejim:ki.test_rejim,video_url:ki.video_url,yt_url:ki.yt_url,faktlar:ki.faktlar,job_id:ki.job_id}}];"
