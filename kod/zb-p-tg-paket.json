      "mode": "runOnceForAllItems",
      "kod": "var base=$(\"Setup birlashtirish\").first().json;var epizodlar=[];try{epizodlar=$(\"Epizod o'qish\").all().map(function(i){return i.json;});}catch(e){}var ctaMatn=\"\";var ctaKod=\"TR-C-0\";try{var cr=$(\"CTA o'qish\").first().json||{};ctaMatn=cr.matn||\"\";ctaKod=cr.kod||\"TR-C-0\";}catch(e){}if([\"T1\",\"T2\",\"T3\"].indexOf(base.mavzu_kod)>=0){ctaMatn=\"\";ctaKod=\"TR-C-0\";}return[{json:{...base,epizodlar:epizodlar,ctaMatn:ctaMatn,ctaKod:ctaKod}}];"
