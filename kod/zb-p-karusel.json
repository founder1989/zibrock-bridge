      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);var p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}var ds=$(\"Ma'lumot tayyorlash\").first().json;return{json:{slaydlar:p.slaydlar||[],caption:p.caption||\"\",heshteglar:[\"#psikoloji\",\"#disiplin\",\"#istatistik\",\"#bilim\",\"#davranisalfinans\"],faktlar:ds.faktlar,burchak:ds.burchak,job_id:ds.job_id,mavzu_kod:ds.mavzu_kod,test_rejim:ds.test_rejim,urinish:ds.urinish||1,slaydSoni:ds.slaydSoni}};"
