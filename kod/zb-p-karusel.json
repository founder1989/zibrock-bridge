    "Karusel ma'lumotlarini tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var inp=$json;\nvar carouselId=\"crs-\"+inp.job_id+\"-\"+Date.now().toString(36);\n// Convert slaydlar to carousel format\nvar slides=(inp.slaydlar||[]).map(function(s,i){\n  var sl={n:s.n||i+1,layout:s.layout||\"content\",title:s.title||\"\"};\n  if(s.subtitle)sl.subtitle=s.subtitle;\n  if(s.body)sl.body=s.body;\n  if(s.button)sl.button=s.button;\n  return sl;\n});\nvar brand={\n  brand_name:\"ZIBROCK\",handle:\"@zibrock_turkiye\",logo_url:\"\",\n  color_ground:\"#0A1727\",color_ground_line:\"#1A2A37\",color_tile:\"#D6AD62\",\n  color_porcelain:\"#F7F5F0\",color_gold:\"#D6AD62\",color_ink:\"#0A1727\",\n  color_muted_dark:\"#9CA3AF\",color_muted_light:\"#6B7280\",\n  font_display:\"Sora\",font_body:\"Inter\",\n  font_css_url:\"https://fonts.googleapis.com/css2?family=Sora:wght@700&family=Inter:wght@600&display=block\",\n  output_format:\"png\",motif_key:\"instrument\"\n};\nvar carousel={language:\"tr\",slides:slides,caption:inp.caption||\"\",hashtags:inp.heshteglar||[]};\nreturn{json:{brand:brand,carousel:carousel,carouselId:carouselId,caption:inp.caption,heshteglar:inp.heshteglar,job_id:inp.job_id}};"
    },
