    "Ma'lumot tayyorlash": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;var pas={};try{pas=$(\"Pasport o'qish\").first().json||{};}catch(e){}var slaydSoni=parseInt(pas.slayd||7);var bazaSlaydlar=[];var bazaBor=false;try{var bazaRow=$(\"Karusel baza o'qish\").first().json||{};if(bazaRow.slaydlar){bazaSlaydlar=JSON.parse(bazaRow.slaydlar||\"[]\");bazaBor=bazaSlaydlar.length>0;if(bazaBor)slaydSoni=bazaSlaydlar.length;}}catch(e){}return[{json:{job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,test_rejim:inp.test_rejim,faktlar:inp.faktlar||[],burchak:inp.burchak,urinish:inp.urinish||1,slaydSoni:slaydSoni,bazaSlaydlar:bazaSlaydlar,bazaBor:bazaBor}}];"
