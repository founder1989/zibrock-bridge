{
  "nodes": {
    "Execute Workflow Trigger": {
      "turi": "executeWorkflow",
      "workflowId": "",
      "inputs": {
        "values": [
          {
            "name": "paket",
            "type": "object"
          }
        ]
      }
    },
    "Kirish tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var p=$json.paket||$json;\nvar burchak=(p.burchaklar&&p.burchaklar.carousel&&p.burchaklar.carousel[0])||\"Karusel burchak\";\nreturn{json:{job_id:p.job_id||\"UNKNOWN\",mavzu_kod:p.mavzu_kod||\"T1\",test_rejim:p.test_rejim||false,faktlar:p.faktlar||[],burchak:burchak,urinish:1}};"
    },
    "Claude - Karusel": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 1500,
      "system": "",
      "creds": {
        "anthropicApi": "Anthropic account 2"
      }
    },
    "Karusel parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);\nvar p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}\nvar inp=$(\"Kirish tayyorlash\").item.json;\nreturn{json:{slaydlar:p.slaydlar||[],caption:p.caption||\"\",heshteglar:p.heshteglar||[],faktlar:inp.faktlar,burchak:inp.burchak,job_id:inp.job_id,test_rejim:inp.test_rejim,urinish:inp.urinish||1}};"
    },
    "Karusel tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var slaydlar=$json.slaydlar||[];var faktlar=$json.faktlar||[];var xatolar=[];\nif(slaydlar.length!==7)xatolar.push(\"Slayd soni \"+slaydlar.length+\", 7 bolishi kerak\");\n// Check 1-slayd ≤8 soz\nif(slaydlar.length>0){var s1=slaydlar[0].title||\"\";var s1w=s1.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});if(s1w.length>8)xatolar.push(\"1-slayd sarlavha \"+s1w.length+\" soz, max 8\");}\n// Check all slides ≤25 soz\nfor(var i=1;i<slaydlar.length-1;i++){var st=slaydlar[i].title||\"\";var sb=slaydlar[i].body||\"\";var comb=(st+\" \"+sb).split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});if(comb.length>25)xatolar.push(\"Slayd \"+(i+1)+\" \"+comb.length+\" soz, max 25\");}\n// Numbers check\nvar fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}\nvar allText=JSON.stringify(slaydlar);var pm=allText.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var fk=0;fk<fr.length;fk++){if(fr[fk].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,slaydlar:slaydlar,caption:$json.caption,heshteglar:$json.heshteglar,faktlar:faktlar,burchak:$json.burchak,job_id:$json.job_id,test_rejim:$json.test_rejim,urinish:$json.urinish||1}};"
    },
