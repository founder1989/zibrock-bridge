    "Slaydlarni birlashtirish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var ds=$(\"Ma'lumot tayyorlash\").first().json;var slaydlar=$json.slaydlar||$json.bazaSlaydlar||[];var caption=$json.caption||\"\";var heshteglar=$json.heshteglar||[\"#psikoloji\",\"#disiplin\",\"#istatistik\",\"#bilim\",\"#davranisalfinans\"];var faktlar=$json.faktlar||ds.faktlar||[];var xatolar=[];var slaydSoni=ds.slaydSoni||7;if(slaydlar.length!==slaydSoni)xatolar.push(\"Slayd soni \"+slaydlar.length+\", \"+slaydSoni+\" kerak\");if(slaydlar.length>0){var s1=slaydlar[0].title||\"\";var s1w=s1.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});if(s1w.length>8)xatolar.push(\"1-slayd sarlavha \"+s1w.length+\" soz, max 8\");}var fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}var allText=JSON.stringify(slaydlar);var pm=allText.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];for(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var fk=0;fk<fr.length;fk++){if(fr[fk].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}return{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,slaydlar:slaydlar,caption:caption,heshteglar:heshteglar,faktlar:faktlar,burchak:$json.burchak||ds.burchak,job_id:$json.job_id||ds.job_id,mavzu_kod:$json.mavzu_kod||ds.mavzu_kod,test_rejim:$json.test_rejim||ds.test_rejim,urinish:$json.urinish||1}};"
    },
