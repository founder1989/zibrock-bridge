    "K1 natijasini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var k1=$json;var cv=$(\"Karusel tekshiruvi\").item.json;\nvar k1H=k1.holat||\"FAIL\";var xa=cv.xatolar||[];\nif(k1H===\"FAIL\"){xa=xa.concat((k1.topilmalar||[]).map(function(t){return\"K1 \"+t.tur+\": \"+t.atama;}));}\nreturn{json:{holat:(cv.holat===\"PASS\"&&k1H===\"PASS\")?\"PASS\":\"FAIL\",xatolar:xa,slaydlar:cv.slaydlar,caption:cv.caption,heshteglar:cv.heshteglar,faktlar:cv.faktlar,burchak:cv.burchak,job_id:cv.job_id,test_rejim:cv.test_rejim,urinish:cv.urinish||1}};"
    },
