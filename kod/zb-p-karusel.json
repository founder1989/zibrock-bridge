      "kod": "var inp=$json;var carouselId=\"crs-\"+inp.job_id+\"-\"+Date.now().toString(36);var slides=(inp.slaydlar||[]).map(function(s,i){var sl={n:s.n||i+1,layout:s.layout||\"content\",title:s.title||\"\"};if(s.subtitle)sl.subtitle=s.subtitle;if(s.body)sl.body=s.body;if(s.button)sl.button=s.button;return sl;});var brand={brand_name:\"ZIBROCK\",handle:\"@zibrock_turkiye\",logo_url:\"\",color_ground:\"#0A1727\",color_ground_line:\"#1A2A37\",color_tile:\"#D6AD62\",color_porcelain:\"#F7F5F0\",color_gold:\"#D6AD62\",color_ink:\"#0A1727\",color_muted_dark:\"#9CA3AF\",color_muted_light:\"#6B7280\",font_display:\"Sora\",font_body:\"Inter\",font_css_url:\"https://fonts.googleapis.com/css2?family=Sora:wght@700&family=Inter:wght@600&display=block\",output_format:\"png\",motif_key:\"instrument\"};var carousel={language:\"tr\",slides:slides,caption:inp.caption||\"\",hashtags:inp.heshteglar||[]};return{json:{brand:brand,carousel:carousel,carouselId:carouselId,caption:inp.caption,heshteglar:inp.heshteglar,job_id:inp.job_id}};"
