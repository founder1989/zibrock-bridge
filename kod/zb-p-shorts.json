    "Kirish tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var p=$json.paket||$json;var vi=parseInt($json.variant_idx||0);\nvar b=(p.burchaklar&&p.burchaklar.yt_short)||[];var burchak=b[vi]||b[0]||\"YT Shorts burchak\";\nreturn{json:{job_id:p.job_id||\"UNKNOWN\",mavzu_kod:p.mavzu_kod||\"T1\",avatar_kod:p.avatar_kod||\"a1\",test_rejim:p.test_rejim||false,faktlar:p.faktlar||[],burchak:burchak,variant_idx:vi,urinish:1,voice_id:p.voice_id||\"7VqWGAWwo2HMrylfKrcm\",talking_photo_id:p.talking_photo_id||\"08617ecb814d40be876db3b1c7b83da0\"}};"
    },
    "Claude - Shorts Skript": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 1200,
      "system": "",
      "creds": {
        "anthropicApi": "Anthropic account 2"
      }
    },
    "Skript parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);\nvar p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}\nvar inp=$(\"Kirish tayyorlash\").item.json;\nreturn{json:{hook:p.hook||\"\",tts_matn:p.tts_matn||\"\",sceneBlocks:p.sceneBlocks||[],manba_toliq:p.manba_toliq||\"\",sarlavha:p.sarlavha||\"\",tavsif:p.tavsif||\"\",heshteglar:p.heshteglar||[],faktlar:inp.faktlar,burchak:inp.burchak,variant_idx:inp.variant_idx,job_id:inp.job_id,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,urinish:inp.urinish||1}};"
    },
    "Skript tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var tts=$json.tts_matn||\"\";var words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});\nvar wc=words.length;var sarlavha=$json.sarlavha||\"\";var mt=$json.manba_toliq||\"\";var faktlar=$json.faktlar||[];var xatolar=[];\nif(wc<110||wc>150)xatolar.push(\"So'z soni \"+wc+\", 110-150 bolishi kerak\");\nif([...sarlavha].length>60)xatolar.push(\"Sarlavha \"+[...sarlavha].length+\" belgi, max 60\");\nif(!mt.match(new RegExp(\"[0-9]{4}\",\"g\")))xatolar.push(\"manba_toliq'da yil yoq\");\nvar fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}\nvar pm=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];\nfor(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var fk=0;fk<fr.length;fk++){if(fr[fk].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}\nreturn{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,tts_matn:tts,hook:$json.hook,sceneBlocks:$json.sceneBlocks,heshteglar:$json.heshteglar,manba_toliq:mt,sarlavha:sarlavha,tavsif:$json.tavsif,faktlar:faktlar,burchak:$json.burchak,variant_idx:$json.variant_idx,job_id:$json.job_id,avatar_kod:$json.avatar_kod,test_rejim:$json.test_rejim,voice_id:$json.voice_id,talking_photo_id:$json.talking_photo_id,urinish:$json.urinish||1}};"
    },
