    "Kirish tayyorlash": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var p=$json.paket||$json;var vi=parseInt($json.variant_idx||0);var b=(p.burchaklar&&p.burchaklar.yt_short)||[];var burchak=b[vi]||b[0]||\"YT Shorts burchak\";return{json:{job_id:p.job_id||\"UNKNOWN\",mavzu_kod:p.mavzu_kod||\"T1\",avatar_kod:p.avatar_kod||\"a1\",test_rejim:p.test_rejim||false,faktlar:p.faktlar||[],burchak:burchak,variant_idx:vi,urinish:1,voice_id:p.voice_id||\"7VqWGAWwo2HMrylfKrcm\",talking_photo_id:p.talking_photo_id||\"08617ecb814d40be876db3b1c7b83da0\"}};"
