    "K1 natijasini birlashtirish": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var k1=$json;var sc=$(\"Skript tekshiruvi\").item.json;\nvar k1H=k1.holat||\"FAIL\";var xa=sc.xatolar||[];\nif(k1H===\"FAIL\"){xa=xa.concat((k1.topilmalar||[]).map(function(t){return\"K1 \"+t.tur+\": \"+t.atama;}));}\nreturn{json:{holat:(sc.holat===\"PASS\"&&k1H===\"PASS\")?\"PASS\":\"FAIL\",xatolar:xa,tts_matn:sc.tts_matn,hook:sc.hook,sceneBlocks:sc.sceneBlocks,heshteglar:sc.heshteglar,manba_toliq:sc.manba_toliq,sarlavha:sc.sarlavha,tavsif:sc.tavsif,faktlar:sc.faktlar,burchak:sc.burchak,variant_idx:sc.variant_idx,job_id:sc.job_id,avatar_kod:sc.avatar_kod,test_rejim:sc.test_rejim,voice_id:sc.voice_id,talking_photo_id:sc.talking_photo_id,urinish:sc.urinish||1}};"
