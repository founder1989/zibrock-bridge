    "Skript parse": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var raw=$json.content&&$json.content[0]&&$json.content[0].text||JSON.stringify($json);var p;try{var s=raw.indexOf(\"{\");var e=raw.lastIndexOf(\"}\");p=JSON.parse(raw.slice(s,e+1));}catch(err){return{json:{xato:true,tur:\"PARSE_FAIL\"}};}var ds=$(\"Ma'lumot tayyorlash\").first().json;return{json:{hook:p.hook||\"\",tts_matn:p.tts_matn||\"\",sceneBlocks:p.sceneBlocks||[],manba_toliq:p.manba_toliq||\"\",sarlavha:p.sarlavha||\"\",tavsif:p.tavsif||\"\",heshteglar:p.heshteglar||[\"#shorts\",\"#psikoloji\",\"#disiplin\"],faktlar:ds.faktlar,burchak:ds.burchak,variant_idx:ds.variant_idx,job_id:ds.job_id,avatar_kod:ds.avatar_kod,test_rejim:ds.test_rejim,voice_id:ds.voice_id,talking_photo_id:ds.talking_photo_id,urinish:ds.urinish||1,minSoz:ds.minSoz,maxSoz:ds.maxSoz,ilgak_s:ds.ilgak_s}};"
    },
    "Skript tekshiruvi": {
      "turi": "code",
      "mode": "runOnceForEachItem",
      "kod": "var tts=$json.tts_matn||\"\";var words=tts.split(new RegExp(\"\\\\s+\",\"g\")).filter(function(w){return w.length>0;});var wc=words.length;var faktlar=$json.faktlar||[];var xatolar=[];var minSoz=$json.minSoz||110;var maxSoz=$json.maxSoz||150;if(wc<minSoz||wc>maxSoz)xatolar.push(\"So'z soni \"+wc+\", \"+minSoz+\"-\"+maxSoz+\" kerak\");var sar=$json.sarlavha||\"\";if([...sar].length>60)xatolar.push(\"Sarlavha \"+[...sar].length+\" belgi, max 60\");var mt=$json.manba_toliq||\"\";if(!mt.match(new RegExp(\"[0-9]{4}\",\"g\")))xatolar.push(\"manba_toliq'da yil yoq\");if(($json.tavsif||\"\").indexOf(\"kanal\")<0&&($json.tavsif||\"\").indexOf(\"http\")<0)xatolar.push(\"Tavsifda uzun videoya havola yo'q\");var fr=[];for(var fi=0;fi<faktlar.length;fi++){var m=String(faktlar[fi].matn||\"\").match(new RegExp(\"[0-9]+\",\"g\"))||[];for(var j=0;j<m.length;j++)fr.push(m[j]);}var pm=tts.match(new RegExp(\"%([0-9]+)\",\"g\"))||[];for(var pi=0;pi<pm.length;pi++){var n=pm[pi].replace(\"%\",\"\");var f=false;for(var k=0;k<fr.length;k++){if(fr[k].indexOf(n)>=0){f=true;break;}}if(!f)xatolar.push(\"Ixtiro raqam: \"+pm[pi]);}return{json:{holat:xatolar.length===0?\"PASS\":\"FAIL\",xatolar:xatolar,tts_matn:tts,hook:$json.hook,sceneBlocks:$json.sceneBlocks,heshteglar:$json.heshteglar,manba_toliq:mt,sarlavha:sar,tavsif:$json.tavsif,faktlar:faktlar,burchak:$json.burchak,variant_idx:$json.variant_idx,job_id:$json.job_id,avatar_kod:$json.avatar_kod,test_rejim:$json.test_rejim,voice_id:$json.voice_id,talking_photo_id:$json.talking_photo_id,urinish:$json.urinish||1,ilgak_s:$json.ilgak_s}};"
    },
