    "Ma'lumot tayyorlash": {
      "turi": "code",
      "mode": "runOnceForAllItems",
      "kod": "var inp=$(\"Kirish tayyorlash\").first().json;var pas={};try{pas=$(\"Pasport o'qish\").first().json||{};}catch(e){}var minS=parseFloat(pas.uzunlik_min_s||45);var maxS=parseFloat(pas.uzunlik_max_s||60);var minSoz=Math.round(minS*2.2);var maxSoz=Math.round(maxS*2.6);var ctaS=\"\";try{var ctaRS=$(\"CTA o'qish\").first().json||{};ctaS=ctaRS.matn||\"\";}catch(e){} if([\"T1\",\"T2\",\"T3\"].indexOf(inp.mavzu_kod)>=0)ctaS=\"\"; return[{json:{job_id:inp.job_id,mavzu_kod:inp.mavzu_kod,avatar_kod:inp.avatar_kod,test_rejim:inp.test_rejim,faktlar:inp.faktlar||[],burchak:inp.burchak,variant_idx:inp.variant_idx,urinish:inp.urinish||1,voice_id:inp.voice_id,talking_photo_id:inp.talking_photo_id,minSoz:minSoz,maxSoz:maxSoz,ilgak_s:parseFloat(pas.ilgak_s||2.0),ctaMatn:ctaS}}];"
    },
    "Claude - Shorts Skript": {
      "turi": "ai",
      "model": "claude-sonnet-4-6",
      "maxTokens": 1200,
